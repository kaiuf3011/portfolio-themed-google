# Ask Kaiuf chat (Claude). Without it, the chat answers from local keyword retrieval.
ANTHROPIC_API_KEY=

# Compose window delivery via Resend. Without both, Send hands the draft to the visitor's email app.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional, must be a domain verified in Resend.
CONTACT_FROM_EMAIL=

# Used for Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://portfolio-themed-google.vercel.app
